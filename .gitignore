# ── 依赖 ──
node_modules/
web/node_modules/

# ── 前端构建产物 ──
web/dist/
dist/

# ── 服务端/植入端构建产物（二进制，不提交） ──
release/toserver.exe
release/toserver
release/implants/
release/data/
# Toshell.* 的运行时状态：构建方式标记（dev|deploy）与 Vite 的 PID 文件
release/.build-mode
release/vite.pid
# 植入端模板生成物：唯一源在 internal/server/builder/implant{,_c}，
# 由 build / 打包同步到这里，以使本地运行与发布包的模板解析路径完全一致。
# 不要手工编辑，会被下次同步覆盖。
release/implant/
release/implant_c/
implants/
*.exe
*.dll
*.so
*.o
*.obj

# ── 敏感配置：含真实密钥/口令，开源请勿提交 ──
# 开源模板见 configs/server.yaml.example
configs/server.yaml
release/configs/server.yaml
configs/local.yaml

# ── 测试 / 回归残留 ──
.regress_hm/
*.db
*.db-wal
*.db-shm
*.log
*.err.log
*.out.log
*.log.err

# ── 临时/调试 ──
tmp/
*.tmp
debug_*.mjs
verify_*.mjs
measure_*.mjs
copilot_*.png
dashboard*.png
*.swp
.DS_Store
Thumbs.db

# ── 编辑器 / IDE / 本地工具配置 ──
# JetBrains 的 .idea/.gitignore 只忽略 workspace.xml，其余（.iml/encodings.xml/
# modules.xml/vcs.xml 等）仍是未跟踪状态，会一直出现在 git status 里。
# 这些是每个开发者本地的 IDE 配置，不入库。
.idea/
# .mcp.json 虽属项目级 MCP 配置（Claude Code 通常建议提交），但本仓库这份指向的是
# 本机 IDE 的固定端口（127.0.0.1:64422），含机器相关信息，对他人无意义。
.mcp.json

# ── 运行时数据目录：仅跟踪"预设文件"，运行时产物（db/上传/传输/uac载荷等）不提交 ──
# 保留目录结构与必需资产：data/av_fingerprints.json（杀软指纹库，服务端必需）、
# data/uploads / data/transfers / data/uac / data/tools / data/backup 目录占位。
data/*
!data/.gitkeep
!data/av_fingerprints.json
!data/uploads/
!data/transfers/
!data/uac/
!data/tools/
!data/backup/
data/uploads/*
!data/uploads/.gitkeep
data/transfers/*
!data/transfers/.gitkeep
data/uac/*
!data/uac/.gitkeep
data/tools/*
!data/tools/.gitkeep
data/backup/*
!data/backup/.gitkeep

# ── 构建/缓存/打包/临时 ──
.gocache/
.check64.c
*.zip
*.html
# 例外：Vite 入口 HTML 是前端源码的一部分，必须入库
# （曾被 *.html 误伤，导致 CI/干净检出 vite build 报 Could not resolve entry module "index.html"）
!web/index.html
release/implants/

# ── 前端 tsc 构建产物 / 含内部凭据的测试脚本（勿提交） ──
web/vite.config.js
web/vite.config.d.ts
web/tsconfig.node.d.ts
web/tsconfig.node.js
web/ws_test.cjs
# 前端构建产物（CI 构建后生成，勿提交）
web/dist/
cmd/server/webdist/
# TypeScript 增量构建缓存（含本机绝对路径，跨机器会误导 tsc，勿提交）
web/*.tsbuildinfo
# 多系统发布二进制（仅作为 GitHub Release 资产，不提交）
release/bin/
# release 发布包 USAGE 说明含真实默认凭据示例，开源不提交（release 内容保留不动）
release/USAGE.md

# 构建临时文件（Go 在 Windows 上覆盖 exe 时的残留）
*.exe~
